{%- extends "partials/layout.njk" -%}
{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}

{% set mainClasses = "govuk-body" %}

{% set guideNav = null %}
{% for item in navigation %}
  {% if item.active %}
    {% set guideNav = item %}
  {% endif %}
{% endfor %}

{% set topNavItems = [] %}
{% for child in guideNav.children %}
  {% if not child.metadata.hiddenFromNav %}
    {% set _ = topNavItems.push({ href: child.path, text: child.title, active: child.active }) %}
  {% endif %}
{% endfor %}

{% set currentSection = null %}
{% for child in guideNav.children %}
  {% if child.active and child.children | length %}
    {% set currentSection = child %}
  {% endif %}
{% endfor %}

{% set sideNavTitle = guideNav.title %}
{% set sideNavItems = [] %}
{% for child in guideNav.children %}
  {% if not child.metadata.hiddenFromNav %}
    {% set _ = sideNavItems.push(child) %}
  {% endif %}
{% endfor %}

{% if currentSection %}
  {% set sideNavTitle = currentSection.title %}
  {% set sideNavItems = [] %}
  {% for child in currentSection.children %}
    {% if not child.metadata.hiddenFromNav %}
      {% set _ = sideNavItems.push(child) %}
    {% endif %}
  {% endfor %}
{% endif %}

{% set breadcrumbItems = [] %}
{% if ancestors and ancestors.length %}
  {% set _ = breadcrumbItems.push({ text: "Home", href: ancestors[0].path }) %}

  {% for ancestor in ancestors.slice(1) %}
    {% if ancestor.title %}
      {% set _ = breadcrumbItems.push({ text: ancestor.title, href: ancestor.path }) %}
    {% endif %}
  {% endfor %}
{% endif %}

{% set guideSearchAction = guideNav.path + '/search' %}

{% block govukHeader %}
  {{ super() }}
  <div class="guide-search-panel" id="guide-search-panel" hidden>
    <div class="govuk-width-container">
      <label class="govuk-label govuk-label--m" for="guide-search-input">Search the guide</label>
      <form class="guide-search-panel__form" method="get" action="{{ guideNav.path }}/search" role="search">
        <input class="govuk-input guide-search-panel__input" id="guide-search-input" type="search" name="q">
        <button class="guide-search-panel__submit" type="submit">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <span class="govuk-visually-hidden">Search</span>
        </button>
      </form>
    </div>
  </div>
{% endblock %}

{% block govukServiceNavigation %}
  {{ govukServiceNavigation({
    navigation: topNavItems
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-one-quarter">
      <nav class="guide-side-nav" aria-labelledby="guide-side-nav-heading">
        <h2 class="govuk-visually-hidden" id="guide-side-nav-heading">Pages in this section</h2>
        {% for group in sideNavItems | groupByMetadata("navGroup") %}
          <h3 class="guide-side-nav__theme">{{ group.name if group.name else sideNavTitle }}</h3>
          <ul class="guide-side-nav__section">
            {% for child in group.items %}
              <li class="guide-side-nav__item{% if child.active %} guide-side-nav__item--current{% endif %}">
                <a class="guide-side-nav__link govuk-link govuk-link--no-visited-state govuk-link--no-underline" href="{{ child.path }}"{% if child.active %} aria-current="page"{% endif %}>
                  {{ child.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endfor %}
      </nav>
    </div>
    <div class="govuk-grid-column-two-thirds">
      {% if breadcrumbItems.length %}
        {{ govukBreadcrumbs({
          collapseOnMobile: true,
          items: breadcrumbItems,
          classes: "govuk-!-display-none-print guide-breadcrumbs-nudge"
        }) }}
      {% endif %}

      <div id="main">
        {% for block in blocks %}
          {{ block | safe }}
        {% endfor %}
      </div>
    </div>
  </div>
  {% if showBackToTop %}
    <div class="guide-back-to-top">
      <a class="govuk-link govuk-link--no-visited-state guide-back-to-top__link" href="#top">
        <svg role="presentation" focusable="false" class="guide-back-to-top__icon" xmlns="http://www.w3.org/2000/svg" width="13" height="17" viewBox="0 0 13 17">
          <path fill="currentColor" d="M6.5 0L0 6.5 1.4 8l4-4v12.7h2V4l4.3 4L13 6.4z"></path>
        </svg>
        Back to top
      </a>
    </div>
  {% endif %}
{% endblock %}
