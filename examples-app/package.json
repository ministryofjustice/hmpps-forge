{
  "name": "hmpps-forge-example-app",
  "version": "0.0.1",
  "description": "HMPPS Forge Examples App",
  "repository": "git@github.com:ministryofjustice/hmpps-forge.git/examples-app",
  "license": "MIT",
  "scripts": {
    "build": "node esbuild/esbuild.js",
    "start": "node $NODE_OPTIONS dist/server.js",
    "start:dev": "node esbuild/esbuild.js --watch",
    "lint": "eslint . --cache --max-warnings 0",
    "lint-fix": "eslint . --cache --max-warnings 0 --fix",
    "typecheck": "tsc && tsc -p integration_tests",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "security_audit": "npx audit-ci --config audit-ci.json",
    "clean": "rm -rf dist test_results",
    "rebuild": "npm run clean && npm run setup && npm run build",
    "setup": "npm --prefix ../packages ci && npm ci && hmpps-npm-script-run-allowlist"
  },
  "engines": {
    "node": "^24",
    "npm": "^11"
  },
  "dependencies": {
    "@ministryofjustice/frontend": "9.0.0",
    "@ministryofjustice/hmpps-auth-clients": "^1.0.1",
    "@ministryofjustice/hmpps-azure-telemetry": "0.0.1-alpha.1",
    "@ministryofjustice/hmpps-forge": "file:../packages",
    "@ministryofjustice/hmpps-monitoring": "^1.0.1",
    "@ministryofjustice/hmpps-rest-client": "^1.0.0",
    "pino": "^9.6.0",
    "compression": "^1.8.1",
    "connect-flash": "^0.1.1",
    "connect-redis": "^9.0.0",
    "csrf-sync": "^4.2.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "govuk-frontend": "^6.1.0",
    "helmet": "^8.1.0",
    "http-errors": "^2.0.1",
    "jwt-decode": "^4.0.0",
    "nocache": "^4.0.0",
    "nunjucks": "^3.2.4",
    "passport": "^0.7.0",
    "passport-oauth2": "^1.8.0",
    "redis": "^5.11.0",
    "superagent": "^10.3.0"
  },
  "devDependencies": {
    "@jgoz/esbuild-plugin-typecheck": "^4.0.4",
    "@ministryofjustice/eslint-config-hmpps": "^1.0.2",
    "@ministryofjustice/hmpps-npm-script-allowlist": "0.0.3",
    "@playwright/test": "^1.58.0",
    "@tsconfig/node24": "^24.0.4",
    "pino-pretty": "^13.0.0",
    "@types/compression": "^1.8.1",
    "@types/connect-flash": "0.0.40",
    "@types/express-session": "^1.18.2",
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.10",
    "@types/nunjucks": "^3.2.6",
    "@types/passport": "^1.0.17",
    "@types/passport-oauth2": "^1.8.0",
    "@types/superagent": "^8.1.9",
    "@types/supertest": "^6.0.3",
    "audit-ci": "^7.1.0",
    "esbuild": "^0.27.2",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-plugin-manifest": "^1.0.5",
    "esbuild-sass-plugin": "^3.6.0",
    "jest": "^30.2.0",
    "jest-html-reporter": "^4.3.0",
    "jest-junit": "^16.0.0",
    "jsonwebtoken": "^9.0.3",
    "nock": "^14.0.10",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
