{
  "name": "hmpps-forge-example-app",
  "version": "0.0.1",
  "description": "HMPPS Forge Examples App",
  "repository": "git@github.com:ministryofjustice/hmpps-forge.git/examples-app",
  "license": "MIT",
  "scripts": {
    "build": "node rolldown/runner.js",
    "start": "node $NODE_OPTIONS dist/server.js",
    "start:dev": "node rolldown/runner.js --watch",
    "lint": "eslint . --cache --max-warnings 0",
    "lint-fix": "eslint . --cache --max-warnings 0 --fix",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --no-file-parallelism",
    "int-test": "npx playwright test",
    "int-test-ui": "npx playwright test --ui",
    "security_audit": "npx audit-ci --config audit-ci.json",
    "clean": "rm -rf dist test_results",
    "rebuild": "npm run clean && npm run setup && npm run build",
    "setup": "npm --prefix ../packages ci && npm ci && hmpps-npm-script-run-allowlist"
  },
  "engines": {
    "node": "^24",
    "npm": "^11"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "@opentelemetry/core": "^2.8.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.0.1",
    "@ministryofjustice/frontend": "9.0.0",
    "@ministryofjustice/hmpps-auth-clients": "^2.0.0",
    "@ministryofjustice/hmpps-azure-telemetry": "0.0.1-alpha.3",
    "@ministryofjustice/hmpps-forge": "file:../packages",
    "@ministryofjustice/hmpps-monitoring": "^2.1.0",
    "@ministryofjustice/hmpps-rest-client": "^2.1.0",
    "compression": "^1.8.1",
    "connect-flash": "^0.1.1",
    "connect-redis": "^9.0.0",
    "csrf-sync": "^4.2.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "govuk-frontend": "^6.1.0",
    "helmet": "^8.1.0",
    "highlight.js": "^11.11.1",
    "http-errors": "^2.0.1",
    "jwt-decode": "^4.0.0",
    "markdown-it": "^14.1.1",
    "markdown-it-attrs": "^4.3.1",
    "minisearch": "^7.2.0",
    "nocache": "^4.0.0",
    "nunjucks": "^3.2.4",
    "passport": "^0.7.0",
    "passport-oauth2": "^1.8.0",
    "pino": "^9.6.0",
    "redis": "^5.11.0",
    "stemmer": "^2.0.1",
    "superagent": "^10.3.0",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@jgoz/esbuild-plugin-typecheck": "^4.0.4",
    "@ministryofjustice/eslint-config-hmpps": "^2.0.0-alpha.1",
    "@ministryofjustice/hmpps-npm-script-allowlist": "0.0.6",
    "@playwright/test": "1.60.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/compression": "^1.8.1",
    "@types/connect-flash": "0.0.40",
    "@types/express-session": "^1.18.2",
    "@types/http-errors": "^2.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-attrs": "^4.1.3",
    "@types/node": "^25.9.3",
    "@types/nunjucks": "^3.2.6",
    "@types/passport": "^1.0.17",
    "@types/passport-oauth2": "^1.8.0",
    "@types/superagent": "^8.1.10",
    "@types/supertest": "^7.2.0",
    "@typescript/native-preview": "^7.0.0-dev.20260412.1",
    "audit-ci": "^7.1.0",
    "esbuild": "^0.28.1",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-plugin-manifest": "^1.0.5",
    "esbuild-sass-plugin": "^3.6.0",
    "jsonwebtoken": "^9.0.3",
    "nock": "^14.0.15",
    "pino-pretty": "^13.0.0",
    "rolldown": "^1.0.0-rc.15",
    "rollup-plugin-sass": "^1.15.3",
    "sass-embedded": "^1.100.0",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
