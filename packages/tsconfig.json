{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "stripInternal": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "sourceMap": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "node",
    "paths": {
      "@ministryofjustice/hmpps-forge/core": ["form-engine/src/index.ts"],
      "@ministryofjustice/hmpps-forge/core/authoring": ["form-engine/src/authoring/index.ts"],
      "@ministryofjustice/hmpps-forge/core/components": ["form-engine/src/components/index.ts"],
      "@ministryofjustice/hmpps-forge/core/framework": ["form-engine/src/framework/index.ts"],
      "@ministryofjustice/hmpps-forge/express-nunjucks": ["form-engine-express-nunjucks/src/index.ts"],
      "@ministryofjustice/hmpps-forge/govuk-components": ["form-engine-govuk-components/src/index.ts"],
      "@ministryofjustice/hmpps-forge/moj-components": ["form-engine-moj-components/src/index.ts"]
    }
  },
  "include": ["./**/src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
