{
  "name": "@ministryofjustice/hmpps-forge",
  "version": "0.3.2",
  "description": "HMPPS Forge",
  "keywords": [
    "hmpps",
    "forge",
    "govuk",
    "nunjucks",
    "forms"
  ],
  "author": "hmpps-developers",
  "license": "MIT",
  "homepage": "https://github.com/ministryofjustice/hmpps-forge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ministryofjustice/hmpps-forge.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.cjs",
      "default": "./dist/core/index.mjs"
    },
    "./core/authoring": {
      "types": "./dist/core/authoring/index.d.ts",
      "import": "./dist/core/authoring/index.mjs",
      "require": "./dist/core/authoring/index.cjs",
      "default": "./dist/core/authoring/index.mjs"
    },
    "./core/components": {
      "types": "./dist/core/components/index.d.ts",
      "import": "./dist/core/components/index.mjs",
      "require": "./dist/core/components/index.cjs",
      "default": "./dist/core/components/index.mjs"
    },
    "./core/framework": {
      "types": "./dist/core/framework/index.d.ts",
      "import": "./dist/core/framework/index.mjs",
      "require": "./dist/core/framework/index.cjs",
      "default": "./dist/core/framework/index.mjs"
    },
    "./core/testing": {
      "types": "./dist/core/testing/index.d.ts",
      "import": "./dist/core/testing/index.mjs",
      "require": "./dist/core/testing/index.cjs",
      "default": "./dist/core/testing/index.mjs"
    },
    "./express-nunjucks": {
      "types": "./dist/express-nunjucks/index.d.ts",
      "import": "./dist/express-nunjucks/index.mjs",
      "require": "./dist/express-nunjucks/index.cjs",
      "default": "./dist/express-nunjucks/index.mjs"
    },
    "./govuk-components": {
      "types": "./dist/govuk-components/index.d.ts",
      "import": "./dist/govuk-components/index.mjs",
      "require": "./dist/govuk-components/index.cjs",
      "default": "./dist/govuk-components/index.mjs"
    },
    "./moj-components": {
      "types": "./dist/moj-components/index.d.ts",
      "import": "./dist/moj-components/index.mjs",
      "require": "./dist/moj-components/index.cjs",
      "default": "./dist/moj-components/index.mjs"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "import": "./dist/devtools/index.mjs",
      "require": "./dist/devtools/index.cjs",
      "default": "./dist/devtools/index.mjs"
    }
  },
  "files": [
    "dist/**/*",
    "*.md"
  ],
  "engines": {
    "node": "20 || 22 || 24"
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.mjs && cp ../README.md ../LICENSE.md ../CHANGELOG.md .",
    "clean": "rm -rf ./dist/",
    "test": "vitest run",
    "lint": "eslint . --cache --max-warnings 0",
    "lint:readability": "eslint \"forge-*/src/**/*.ts\" --config eslint.readability.config.mjs --no-cache",
    "lint-fix": "eslint . --cache --max-warnings 0 --fix",
    "typecheck": "tsgo --noEmit"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@boundaries/eslint-plugin": "^7.1.0",
    "@ministryofjustice/eslint-config-hmpps": "^1.0.3",
    "@ministryofjustice/frontend": "^10.0.1",
    "@tsconfig/node24": "^24.0.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.1",
    "@types/nunjucks": "^3.2.6",
    "@types/ws": "^8.18.1",
    "@typescript/native-preview": "^7.0.0-dev.20260412.1",
    "@vitest/coverage-v8": "^4.1.4",
    "@yikes2000/prettier-plugin-merge-extras": "^0.7.3-extras.2",
    "eslint": "^10.7.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-sonarjs": "^4.1.0",
    "eslint-plugin-vitest": "^0.5.4",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "govuk-frontend": "^6.1.0",
    "http-errors": "^2.0.1",
    "magic-string": "^1.0.0",
    "nunjucks": "^3.2.4",
    "preact": "^10.29.2",
    "rolldown": "^1.0.0-rc.15",
    "rolldown-plugin-dts": "^0.27.12",
    "sass": "^1.101.0",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.4",
    "vitest-when": "^0.10.0"
  },
  "dependencies": {
    "express": "^4.21.0 || ^5.0.0",
    "http-errors": "^2.0.0",
    "nunjucks": "^3.2.4",
    "ws": "^8.18.0",
    "zod": "^4.1.5"
  }
}
