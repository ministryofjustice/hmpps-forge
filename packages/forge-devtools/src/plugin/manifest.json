{
  "manifest_version": 3,
  "name": "Forge DevTools",
  "version": "0.1.0",
  "description": "Developer tools for Forge applications",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "devtools_page": "devtools.html"
}
